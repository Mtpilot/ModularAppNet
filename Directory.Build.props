<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>All</AnalysisMode>
    <!-- Do not treat all warnings as errors for the solution; specific severities are controlled via .editorconfig -->
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Do not force code analysis diagnostics to be treated as errors; rely on .editorconfig/project settings -->
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <!-- Ensure CA1873 stays a warning even when warnings are treated as errors globally -->
    <WarningsNotAsErrors>$(WarningsNotAsErrors);CA1873;CA1711;CA1040;CA1716;CA2225;CA1002</WarningsNotAsErrors>
    <!-- As a fallback, suppress these diagnostics entirely at solution level to avoid them being reported as errors by analyzers that force severity -->
    <NoWarn>$(NoWarn);CA1873;CA1711;CA1040;CA1716;CA2225;CA1002</NoWarn>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  
  <ItemGroup>
    <PackageReference Include="Meziantou.Analyzer">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="SonarAnalyzer.CSharp">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Roslynator.Analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.analyzers">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  
</Project>