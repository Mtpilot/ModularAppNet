<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Ensure CA1873 stays a warning in this project (in case warnings are promoted to errors globally) -->
    <WarningsNotAsErrors>CA1873</WarningsNotAsErrors>
    <!-- Also explicitly silence CA1873 in this project to avoid it being treated as error by global settings -->
    <NoWarn>$(NoWarn);CA1873</NoWarn>
  </PropertyGroup>
  
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  
  <ItemGroup>
    <None Include="Features\GetWorkflow\GetWorkflow.Handler.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Common\Modules.Common.API\Modules.Common.API.csproj" />
    <ProjectReference Include="..\..\Common\Modules.Common.Application\Modules.Common.Application.csproj" />
    <ProjectReference Include="..\Modules.Workflows.Domain\Modules.Workflows.Domain.csproj" />
    <ProjectReference Include="..\Modules.Workflows.Infrastructure\Modules.Workflows.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules.Workflows.MockInfrastructure\Modules.Workflows.MockInfrastructure.csproj" />
    <ProjectReference Include="..\Modules.Workflows.PublicApi\Modules.Workflows.PublicApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />       
  </ItemGroup>

</Project>
